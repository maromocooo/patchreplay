    "url": "https://github.com/maromocooo/patchreplay/issues"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "playwright-core": "1.64.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.9.0"
